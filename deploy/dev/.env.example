# Compose interpolation
REPO_DIR=/path/to/streamhub            # as the Docker host sees it
DEV_CONFIG_DIR=/path/to/dev-config     # separate from the live /config
DEV_ENV_FILE=/path/to/this/file
DEV_PORT=8788
PUID=1000
PGID=1000
# Container environment
SECRET_KEY=change-me-long-random
ADMIN_PASSWORD=change-me
GOOGLE_AUTH_REQUIRED=false
TZ=Etc/UTC
