# Watchdog
PROBE_URL=http://engine.example:9191/hdhr/lineup.json   # must hit the engine's database
TARGET_CONTAINER=dispatcharr
PROBE_INTERVAL=60
FAIL_THRESHOLD=3
COOLDOWN=600
NOTIFY_WEBHOOK=                                         # optional; receives {"text": "..."}

# Docker API access: a socket proxy that allows container restart
DOCKER_HOST=tcp://docker-socket-proxy:2375
DOCKER_API_NETWORK=socket-proxy_default

# Nightly backup (hour is UTC)
BACKUP_HOUR=9
BACKUP_KEEP=7
BACKUP_SOURCES=/src/engine-backups /src/streamhub-config/streamhub.db
BACKUP_DEST_HOST=/path/on/array/media-stack-backups
ENGINE_BACKUPS_HOST=/path/to/engine-data/backups
STREAMHUB_CONFIG_HOST=/path/to/streamhub/config
