{
  "name": "streamhub-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "predev": "npm run gen:tokens",
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "prebuild": "npm run gen:tokens",
    "build": "tsc -b && vite build",
    "build:mock": "VITE_MOCK=1 vite build --outDir dist-mock",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "postbuild": "node -e \"require('fs').rmSync('dist/mock',{recursive:true,force:true});require('fs').rmSync('dist/mockServiceWorker.js',{force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "msw": "^3.0.3",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation-core": "^4.2.0",
    "@noriginmedia/norigin-spatial-navigation-react": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "shaka-player": "^5.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}